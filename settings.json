{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/auto-resume/detect.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/fable-advice/advise.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/language-drift/check.mjs\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/report-gaps/check.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "trinity@yjn279": true
  },
  "extraKnownMarketplaces": {
    "yjn279": {
      "source": {
        "source": "github",
        "repo": "yjn279/trinity",
        "ref": "main"
      }
    }
  },
  "cleanupPeriodDays": 90,
  "effortLevel": "xhigh",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
